# Reflow Studio environment
#
# Local development: copy this file to apps/web/.env.local and fill in the REQUIRED block.
# Vercel: Project, Settings, Environment Variables (you can paste the whole block there).
# Empty values count as unset, so optional lines can stay empty or commented out.
#
# Generate a random secret with any of these:
#   Node (any OS):           node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   Windows PowerShell 5.1:  $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   macOS / Linux:           openssl rand -base64 32

# =============================================================================
# REQUIRED
# =============================================================================

# --- Supabase: Dashboard, Project settings, API keys ---
# The Vercel Supabase integration injects NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY and POSTGRES_URL*;
# those names are accepted as they are. Explicit names below win when both exist.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. Server only: never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Deploy secret ---
# One random value of at least 32 characters (see the generators above). The webhook,
# reconcile and provider-key encryption secrets are derived from it, and you type it
# once on /setup to create your owner account. Keep it stable: a new value makes
# provider keys saved in the app unreadable (you would paste them again).
REFLOW_SECRET=

# --- Access ---
# The e-mail address(es) you sign in with, comma-separated. Production refuses every
# login without it, and the database refuses new accounts for any other address.
OWNER_EMAILS=

# =============================================================================
# RECOMMENDED
# =============================================================================

# Hard cap on provider spend per calendar month in USD (0 or unset = no cap).
MONTHLY_BUDGET_USD=10

# Database URL for build-time migrations (scripts/migrate.mjs runs before `next build`).
# Set automatically by the Vercel Supabase integration (POSTGRES_URL_NON_POOLING / POSTGRES_URL).
# Bring your own Supabase: Dashboard, Connect, "Session pooler" connection string
# (the direct db.<ref> host is IPv6-only and Vercel builds cannot reach it).
# Only production builds migrate; preview builds skip the step.
# Local: node --env-file=.env.local scripts/migrate.mjs
# POSTGRES_URL_NON_POOLING=
# SUPABASE_DB_URL=

# =============================================================================
# OPTIONAL
# =============================================================================

# Public URL of this deployment, used for provider webhooks and the pg_cron reconciler.
# Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel and http://localhost:3000 locally.
# APP_BASE_URL=https://studio.your-domain.com

# --- Provider keys ---
# Preferred: paste keys in Settings, Providers (encrypted with a key derived from REFLOW_SECRET).
# Environment keys are a fallback for headless setups and are used when nothing is saved in the app.
# FAL_KEY=
# KIE_API_KEY=
# Higgsfield API credentials as KEY_ID:KEY_SECRET (console.higgsfield.ai).
# HIGGSFIELD_API_CREDENTIAL=
# HMAC key from Kie Settings, Webhook signing; enables signature checks on Kie webhooks.
# KIE_WEBHOOK_SECRET=

# --- Storage: Cloudflare R2 (S3 API) ---
# Leave unset to use Supabase Storage (free plan: 50 MB per file, 1 GB total).
# All four values are needed to switch to R2 (free up to 10 GB, no egress fees; Cloudflare asks for a payment method).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=reflow-studio
# Public base URL of the bucket (a custom domain). Leave unset to serve media through presigned URLs;
# r2.dev URLs are rate limited and meant for development only.
# R2_PUBLIC_URL=

# --- Routing defaults (the preference saved in Settings, Providers overrides these) ---
# PROVIDER_STRATEGY=cheapest
# PROVIDER_PREFERENCE=kie,fal

# --- Development ---
# Free mock provider: exercises the whole UI, API and MCP flow without provider keys.
# ENABLE_MOCK_PROVIDER=true
# Show "Create account" on the login page even when OWNER_EMAILS is set.
# ALLOW_SIGNUP=false

# --- Migrations ---
# Adopt a database whose schema was applied by hand (SQL editor): the number of the last
# migration that is already in place. The build records 0001..N as applied and runs the rest.
# REFLOW_MIGRATE_BASELINE=0006
# Turn the build-time migration step off (when you run `supabase db push` yourself).
# REFLOW_SKIP_MIGRATIONS=true

# --- Experimental ---
# OAuth issuers advertised on /.well-known/oauth-protected-resource.
# MCP_OAUTH_ISSUERS=

# --- Legacy secrets (deployments created before REFLOW_SECRET) ---
# Each one wins over the value derived from REFLOW_SECRET. Keep them on an existing
# deployment: KEY_ENCRYPTION_SECRET decrypts provider keys already stored in the app.
# WEBHOOK_SECRET=
# RECONCILE_SECRET=
# KEY_ENCRYPTION_SECRET=
